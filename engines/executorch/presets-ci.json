{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "vendor": {
    "anira": {
      "doc": "CI legs of the executorch engine. Every visible preset carries its CI + naming metadata in vendor.anira (engine-meta jq-parses this file into the matrix). Included by the root CMakePresets.json; edit here so only the executorch workflow re-triggers."
    }
  },
  "include": [
    "../../cmake/presets/orch-base.json"
  ],
