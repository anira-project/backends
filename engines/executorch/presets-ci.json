        "BACKENDS_PLATFORM": "macos",
        "BACKENDS_ARCH": "x86_64",
        "BACKENDS_CONFIG": "Release",
        "BACKENDS_KIND": "static",
        "BACKENDS_SOURCE": "build"
      },
      "vendor": {
        "anira": {
          "name": "macOS-x86_64",
          "runner": "macos-15-intel",
          "arch": "x86_64",
          "kind": "static",
          "config": "Release",
          "canRun": "1",
          "toolchain": "none",
          "source": "build"
        }
      }
    },
