{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "vendor": {
    "anira": {
      "doc": "CI legs of the libtorch engine. Every visible preset carries its CI + naming metadata in vendor.anira (engine-meta jq-parses this file into the matrix). Included by the root CMakePresets.json; edit here so only the libtorch workflow re-triggers."
    }
  },
  "include": [
    "../../cmake/presets/orch-base.json"
  ],
  "configurePresets": [
    {
      "name": "libtorch-macos-x86_64-shared",
      "inherits": "orch-base",
      "cacheVariables": {
        "BACKENDS_ENGINE": "libtorch",
        "BACKENDS_PLATFORM": "macos",
        "BACKENDS_ARCH": "x86_64",
        "BACKENDS_CONFIG": "Release",
        "BACKENDS_KIND": "shared",
        "BACKENDS_SOURCE": "build"
      },
      "vendor": {
        "anira": {
          "name": "macOS-x86_64",
          "runner": "macos-15-intel",
          "arch": "x86_64",
          "kind": "shared",
          "config": "Release",
          "canRun": "1",
          "toolchain": "none",
          "source": "build"
        }
      }
    },
    {
      "name": "libtorch-macos-arm64-shared",
